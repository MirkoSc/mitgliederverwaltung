# Written by the Mitgliederverwaltung - do not remove. Nothing in this
# directory may ever be served by the web server, even if a domain is
# pointed one level too high (docs/spec/01-plattform.md section 2).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
