Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    # setifempty: a page that carries a token in its URL may send its own
    # "no-referrer" from PHP; a plain "set" in the always table would
    # overwrite it under FastCGI.
    Header always setifempty Referrer-Policy "strict-origin-when-cross-origin"
    # script-src 'self' without 'unsafe-inline' is the point of this header
    # (CLAUDE.md section 4): no inline <script>, no on* attributes, htmx
    # without hx-on. Every JS library is vendored under public/js/vendor/,
    # so no external host appears anywhere in the policy, and 'unsafe-eval'
    # is not needed (htmx works without it). tests/Http/CspComplianceTest.php
    # keeps the templates and this line in step.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    # HTTPS is an installation requirement, so committing to it is safe.
    Header always set Strict-Transport-Security "max-age=15768000"
    # frame-ancestors above already forbids framing; X-Frame-Options
    # repeats it for browsers without CSP level 2.
    Header always set X-Frame-Options "DENY"
    # The application uses no device feature at all.
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), midi=()"
    # A page opened from here via a link in a new tab gets no handle back
    # to a tab that shows member data.
    Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>

RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]
